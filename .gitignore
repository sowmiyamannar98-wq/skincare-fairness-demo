# contains a single 270 MB file, over GitHub's 100 MB hard limit. Appendix C of
# the report states the source datasets are not redistributed; keep it true.
data/sephora/
data/fitzpatrick17k/

# --- deployment copies ---------------------------------------------------
# Generated from app/ and scripts/ (see HANDOFF section 11). Each bundles its
# own copy of the 91 MB checkpoint, so committing them would triple it.
# streamlit_cloud/ is already its own git repo and deploys separately.
hf_space/
streamlit_cloud/

